<% if (it.groups.length) { %>
\begin{refsection}
\begin{refcontext}[sorting=none]
<%~ it.bib.cite() %>
<% for (const group of it.groups) { %>
<%~ it.bib.group(group) %>
\printbibliography[resetnumbers=true, check=vita-<%~ group.id %>, <% if (group.label !== undefined) { %>heading=subbibliography, title={<%~ it.text(group.label) %>}<% } else { %>heading=none<% } %>]
<% } %>
\end{refcontext}
\end{refsection}
<% } %>
