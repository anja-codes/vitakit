<% for (const item of it.entries) { %>
<%~ it.vita.entry({
  date: it.date(item.date),
  title: item.position,
  context: it.linked(item.institution)
}) %>
<% if (item.project) { %>
<%~ it.vita.note(it.join([
  it.optional`Project \emph{${it.linked(item.project.title, item.project.url)}}`,
  item.project.funder
    ? it.optional` (${it.join([item.project.funder, item.project.grant], it.optional`~`)})`
    : ''
], '')) %>
<% } %>
<%~ it.vita.note(item.note) %>
<% } %>
