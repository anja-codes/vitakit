<% for (const item of it.entries) { %>
<%~ it.vita.entry({
  date: it.date(item.date),
  title: item.degree,
  context: it.linked(item.institution)
}) %>
<% if (item.thesis) { %>
<%~ it.vita.note(it.join([
  it.optional`${item.thesis.type ?? 'Thesis'}: \emph{${item.thesis.title}}`,
  it.optional`, supervised by ${it.linked(item.thesis.supervisor)}`
], '')) %>
<% } %>
<%~ it.vita.note(item.note) %>
<% } %>
