<% for (const item of it.entries) { %>
<%~ it.vita.entry({
  date: it.join([it.date(item.date), item.ongoing ? '--' : ''], ''),
  title: item.student,
  context: it.join([item.degree, it.linked(item.institution)])
}) %>
<%~ it.vita.note(it.join([
  it.optional`\emph{${item.title}}`,
  it.optional`, with ${item.coSupervisor}`,
  item.ongoing ? ' (in progress)' : ''
], '')) %>
<% } %>
