%% vitakit-cv.cls -- document class for CVs generated by vitakit.
%%
%% The generated section files only ever use the macros defined here, so the
%% entire visual design can be changed by redefining them in preamble.tex
%% without touching anything vitakit produces.
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{vitakit-cv}[2026/01/01 vitakit CV class]

%% Options must be declared and processed before the base class is loaded.
\newif\ifvita@bib \vita@bibtrue
\DeclareOption{nobib}{\vita@bibfalse}
\DeclareOption*{\PassOptionsToClass{\CurrentOption}{article}}
\ProcessOptions\relax
\LoadClass[11pt,a4paper]{article}

%% pdfLaTeX's default font encoding (OT1) has no „, ‚, ł, ő and many other
%% characters of names, places and titles; T1 has them. LuaLaTeX and XeLaTeX
%% use Unicode fonts instead.
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage{lmodern}
\fi

\RequirePackage[margin=2.5cm]{geometry}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{amsmath,amssymb}
\RequirePackage{hyperref}

%% --- bibliography ---------------------------------------------------------
%% biblatex is loaded here so that a CV needs no bibliography setup at all.
%% Pass [nobib] to the class and load it yourself to use a different style.
\ifvita@bib
  \RequirePackage[backend=biber, style=numeric, sorting=ydnt,
                  defernumbers=true, maxbibnames=99, giveninits=true]{biblatex}
  %% \vitabibgroup{id}{key,key,...} defines the bibliography check `vita-id`,
  %% which keeps exactly the listed entries. The generated publications.tex
  %% uses one per group: vitakit decides the groups, with the website's rules
  %% (a missing `status` is `published`, case does not matter), so the PDF
  %% lists what the website lists. Keys are compared as strings.
  \newcommand{\vitabibgroup}[2]{%
    \defbibcheck{vita-#1}{%
      \edef\vita@bibkey{\thefield{entrykey}}%
      \def\vita@bibfound{0}%
      \forcsvlist{\vita@bibmatch}{#2}%
      \ifnum\vita@bibfound=0 \skipentry\fi}}
  \newcommand{\vita@bibmatch}[1]{%
    \expandafter\ifstrequal\expandafter{\vita@bibkey}{#1}{\def\vita@bibfound{1}}{}}
  %% `status` is also copied to `keywords`, for hand-written
  %% \printbibliography[keyword=...] calls.
  \DeclareSourcemap{\maps[datatype=bibtex]{
    \map{\step[fieldsource=status, fieldtarget=keywords]}
    %% The same custom fields the website turns into badges. `final` stops the
    %% map for entries without the field, which must not become arXiv eprints.
    \map{\step[fieldsource=arxiv, final]
         \step[fieldsource=arxiv, fieldtarget=eprint]
         \step[fieldset=eprinttype, fieldvalue=arxiv]}
    %% biblatex expects a bare DOI; exports also write doi:10... or a URL.
    \map{\step[fieldsource=doi,
               match=\regexp{\A(doi:\s*|https?://(dx\.)?doi\.org/)}, replace={}]}
  }}
\fi

\definecolor{vitalink}{HTML}{1D4ED8}
\definecolor{vitamuted}{HTML}{555555}
\hypersetup{colorlinks=true, urlcolor=vitalink, linkcolor=vitalink, pdfborder={0 0 0}}

%% --- document selection --------------------------------------------------
%% \vitadocument{name} points \vitasection at cv-tex/generated/<name>/.
\newcommand{\vitadocument}[1]{\def\vita@document{#1}}
\vitadocument{cv}

%% --- data from content/profile.yml ---------------------------------------
\newcommand{\vitaname}[1]{\def\vita@name{#1}}
\newcommand{\vitatagline}[1]{\def\vita@tagline{#1}}
\newcommand{\vitacontact}[1]{\def\vita@contact{#1}}
\vitaname{} \vitatagline{} \vitacontact{}

\newcommand{\vitaheader}{%
  \begingroup
  \noindent{\LARGE\bfseries\vita@name}\par
  \ifx\vita@tagline\empty\else\vspace{0.2em}\noindent{\color{vitamuted}\vita@tagline}\par\fi
  \ifx\vita@contact\empty\else\vspace{0.2em}\noindent{\small\vita@contact}\par\fi
  \vspace{1em}\hrule\vspace{1.5em}
  \endgroup}

%% --- sections ------------------------------------------------------------
%% Section headings are real \section commands, so the table of contents and
%% PDF bookmarks work as usual.
\titleformat{\section}{\large\bfseries}{}{0pt}{}
\titlespacing*{\section}{0pt}{1.4em}{0.6em}

%% Per-document heading overrides: \vitasectiontitle{teaching}{Courses taught}
\newcommand{\vitasectiontitle}[2]{\expandafter\def\csname vita@title@#1\endcsname{#2}}
\newcommand{\vita@titlefor}[1]{%
  \ifcsname vita@title@#1\endcsname\csname vita@title@#1\endcsname\else#1\fi}

\newenvironment{vitaentries}
  {\begin{list}{}{%
     \setlength{\leftmargin}{7em}\setlength{\labelwidth}{6.4em}%
     \setlength{\labelsep}{0.6em}\setlength{\itemsep}{0.5em}%
     \setlength{\parsep}{0pt}\setlength{\topsep}{0.3em}%
     \renewcommand{\makelabel}[1]{\small\color{vitamuted}##1\hfill}}}
  {\end{list}}

%% \vitaentry{date}{title}{context}
\newcommand{\vitaentry}[3]{%
  \item[#1]{\bfseries #2}%
  \ifx\relax#3\relax\else\par{\small #3}\fi}

%% A continuation line inside the current entry. Uses \par rather than \\ so
%% that it is safe after any preceding content, including none.
\newcommand{\vitanote}[1]{\par{\small\color{vitamuted}#1}}

%% Generated profile.tex marks sections whose selection is empty.
\newcommand{\vitaemptysection}[1]{\expandafter\def\csname vita@empty@#1\endcsname{}}

%% \vitasection[Heading]{id} -- an optional heading for this invocation only.
%% Otherwise use the document/preamble label, falling back to the section id.
\NewDocumentCommand{\vitasection}{o m}{%
  \ifcsname vita@empty@#2\endcsname\else
    \IfNoValueTF{#1}{\section{\vita@titlefor{#2}}}{\section{#1}}%
    \begin{vitaentries}%
    \input{generated/\vita@document/#2.tex}%
    \end{vitaentries}%
  \fi}

%% \vitainput{id} -- the generated file without heading or list wrapper,
%% for sections that bring their own structure (publications).
\newcommand{\vitainput}[1]{\input{generated/\vita@document/#1.tex}}

\endinput
