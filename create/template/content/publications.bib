% Your publication list. Export it from Zotero, JabRef or arXiv and replace the
% examples below.
%
% The non-standard `status` field decides the grouping on /publications/ and in
% the PDF: published, accepted, preprint, software or other; without it, an
% entry is published. To change the groups:
%     pnpm vitakit customize publications    # -> schemas/publications.ts
%
% `doi`, `arxiv`, `mrnumber` and `zbl` become links; `eprint` with
% `eprinttype = {arxiv}` (or `archivePrefix`) works as `arxiv` does, so exports
% from Zotero, JabRef or arXiv need no editing. Mathematics in titles works:
% write $...$ as usual.
%
% The website formats this list with a CSL style. To change it:
%     pnpm vitakit eject publications.csl    # -> content/publications.csl
% or save any CSL style under that name.

@article{example-published,
  author  = {Doe, Jane and Roe, Richard},
